<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Hermetic restores: this repo needs only Akaule.NimBus.Abstractions and the test
       packages, all on nuget.org. Clearing inherited sources keeps machine-level feeds
       (e.g. private ADO feeds that require auth) from breaking a restore. The pipeline
       authenticates against the Azure Artifacts feed for the *push* only, which does not
       go through this file. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
