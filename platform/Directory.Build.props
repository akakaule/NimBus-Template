<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <!-- The catalog decides the Service Bus topology and what the management UI renders, so
         the version a deployment pins is a reviewed change: bump this, merge, and then move
         the platform-package pin in the deploy pipeline. The publish pipeline pushes with
         skip-duplicate, so re-running a build that did not bump this is a no-op rather than
         a failure. -->
    <VersionPrefix>1.0.0</VersionPrefix>

    <!-- The `nb` CLI reflection-loads this assembly to read the catalog, so it must be built
         against the NimBus version the deployment runs. Kept in one place because the deploy
         pipeline pins the same number for the CLI itself. -->
    <NimBusVersion>3.2.0</NimBusVersion>
  </PropertyGroup>

  <!-- REPLACE: your organisation and the repository this ends up in. The URLs are metadata
       on the published package, so they are what someone reading it in the feed follows back
       to the source. -->
  <PropertyGroup>
    <Company>Acme</Company>
    <Authors>Acme</Authors>
    <PackageProjectUrl>https://dev.azure.com/acme/Integration/_git/Acme.Platform</PackageProjectUrl>
    <RepositoryUrl>https://dev.azure.com/acme/Integration/_git/Acme.Platform</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

</Project>
